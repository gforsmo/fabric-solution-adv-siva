model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: nb-NO
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Bedrifter","Dato","Meldingslogg","Regnskap","Oppdateringsmetadata","RangeStart","RangeEnd"]

ref table Bedrifter
ref table Dato
ref table Meldingslogg
ref table Regnskap
ref table _Nøkkeltall
ref table Oppdateringsmetadata

ref cultureInfo en-US

